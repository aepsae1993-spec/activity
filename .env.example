# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงจาก Supabase
# (Supabase Dashboard > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# รหัสผ่านสำหรับยืนยันการลบกิจกรรม (ถ้าไม่ตั้งจะใช้ค่า default: admin1234)
NEXT_PUBLIC_DELETE_PASSWORD=admin1234
